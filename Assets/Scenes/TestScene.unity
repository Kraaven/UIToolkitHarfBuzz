--- !u!114 &162812099
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 162812094}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dd72c2f33f8e392489fbe67a87b03a6a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  TextToAnimate: "\u0BA4\u0BC1\u0BB3\u0BC8\u0BAF\u0BBF\u0B9F\u0BC1\u0BA4\u0BB2\u0BCD
    \u0B8E\u0BA9\u0BCD\u0BAA\u0BA4\u0BC1 \u0B92\u0BB0\u0BC1 \u0BB5\u0BC6\u0B9F\u0BCD\u0B9F\u0BC1\u0BAE\u0BCD
    \u0B9A\u0BC6\u0BAF\u0BB2\u0BCD\u0BAE\u0BC1\u0BB1\u0BC8\u0BAF\u0BBE\u0B95\u0BC1\u0BAE\u0BCD,
    \u0B87\u0BA4\u0BBF\u0BB2\u0BCD \u0BA4\u0BBF\u0B9F\u0BAA\u0BCD\u0BAA\u0BCA\u0BB0\u0BC1\u0B9F\u0BCD\u0B95\u0BB3\u0BBF\u0BB2\u0BCD
    \u0BB5\u0B9F\u0BCD\u0B9F \u0B95\u0BC1\u0BB1\u0BC1\u0B95\u0BCD\u0B95\u0BC1\u0BB5\u0BC6\u0B9F\u0BCD\u0B9F\u0BC1
    \u0BA4\u0BC1\u0BB3\u0BC8 \u0BB5\u0BC6\u0B9F\u0BCD\u0B9F\u0BC1\u0BB5\u0BA4\u0BB1\u0BCD\u0B95\u0BC1
    \u0B92\u0BB0\u0BC1 \u0BA4\u0BC1\u0BB0\u0BAA\u0BCD\u0BAA\u0BA3 \u0BAA\u0BBF\u0B9F\u0BCD
    \u0B9A\u0BC1\u0BB4\u0BB1\u0BCD\u0BB1\u0BAA\u0BCD\u0BAA\u0B9F\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1.
    \u0BA4\u0BC1\u0BB0\u0BAA\u0BCD\u0BAA\u0BA3 \u0BAA\u0BBF\u0B9F\u0BCD \u0BAA\u0BCA\u0BA4\u0BC1\u0BB5\u0BBE\u0B95
    \u0B92\u0BB0\u0BC1 \u0B9A\u0BC1\u0BB4\u0BB2\u0BC1\u0BAE\u0BCD \u0BB5\u0BC6\u0B9F\u0BCD\u0B9F\u0BC1\u0BAE\u0BCD
    \u0B95\u0BB0\u0BC1\u0BB5\u0BBF\u0BAF\u0BBE\u0B95\u0BC1\u0BAE\u0BCD, \u0BAA\u0BC6\u0BB0\u0BC1\u0BAE\u0BCD\u0BAA\u0BBE\u0BB2\u0BC1\u0BAE\u0BCD
    \u0BAA\u0BB2-\u0BAA\u0BC1\u0BB3\u0BCD\u0BB3\u0BBF. \u0BAA\u0BBF\u0B9F\u0BCD \u0BB5\u0BC7\u0BB2\u0BC8\u0BAA\u0BCD
    \u0BAA\u0B95\u0BC1\u0BA4\u0BBF\u0B95\u0BCD\u0B95\u0BC1 \u0B8E\u0BA4\u0BBF\u0BB0\u0BBE\u0B95
    \u0B85\u0BB4\u0BC1\u0BA4\u0BCD\u0BA4\u0BAA\u0BCD\u0BAA\u0B9F\u0BCD\u0B9F\u0BC1
    \u0BA8\u0BBF\u0BAE\u0BBF\u0B9F\u0BA4\u0BCD\u0BA4\u0BBF\u0BB1\u0BCD\u0B95\u0BC1
    \u0BA8\u0BC2\u0BB1\u0BCD\u0BB1\u0BC1\u0B95\u0BCD\u0B95\u0BA3\u0B95\u0BCD\u0B95\u0BBE\u0BA9
    \u0B9A\u0BC1\u0BB4\u0BB1\u0BCD\u0B9A\u0BBF\u0B95\u0BB3\u0BCD \u0BB5\u0BB0\u0BC8
    \u0B9A\u0BC1\u0BB4\u0BB1\u0BCD\u0BB1\u0BAA\u0BCD\u0BAA\u0B9F\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1.
    \u0B87\u0BA4\u0BC1 \u0BB5\u0BC6\u0B9F\u0BCD\u0B9F\u0BC1 \u0BB5\u0BBF\u0BB3\u0BBF\u0BAE\u0BCD\u0BAA\u0BC8
    \u0BB5\u0BC7\u0BB2\u0BC8\u0BAA\u0BCD \u0BAA\u0B95\u0BC1\u0BA4\u0BBF\u0B95\u0BCD\u0B95\u0BC1
    \u0B8E\u0BA4\u0BBF\u0BB0\u0BBE\u0B95 \u0B95\u0B9F\u0BCD\u0B9F\u0BBE\u0BAF\u0BAA\u0BCD\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1,
    \u0BA4\u0BC1\u0BB3\u0BC8\u0BAF\u0BBF\u0B9F\u0BC1\u0BAE\u0BCD\u0BAA\u0BCB\u0BA4\u0BC1
    \u0BA4\u0BC1\u0BB3\u0BC8\u0BAF\u0BBF\u0BB2\u0BBF\u0BB0\u0BC1\u0BA8\u0BCD\u0BA4\u0BC1
    \u0B9A\u0BBF\u0BB2\u0BCD\u0BB2\u0BC1\u0B95\u0BB3\u0BC8 (\u0BB8\u0BCD\u0BB5\u0BBE\u0BB0\u0BCD\u0B83\u0BAA\u0BCD)
    \u0BB5\u0BC6\u0B9F\u0BCD\u0B9F\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1.  \u0BAA\u0BBE\u0BB1\u0BC8
    \u0BA4\u0BC1\u0BB3\u0BC8\u0BAF\u0BBF\u0B9F\u0BC1\u0BA4\u0BB2\u0BBF\u0BB2\u0BCD,
    \u0BA4\u0BC1\u0BB3\u0BC8 \u0BAA\u0BCA\u0BA4\u0BC1\u0BB5\u0BBE\u0B95 \u0BB5\u0B9F\u0BCD\u0B9F
    \u0BB5\u0BC6\u0B9F\u0BCD\u0B9F\u0BC1 \u0B87\u0BAF\u0B95\u0BCD\u0B95\u0BA4\u0BCD\u0BA4\u0BBF\u0BA9\u0BCD
    \u0BAE\u0BC2\u0BB2\u0BAE\u0BCD \u0B9A\u0BC6\u0BAF\u0BCD\u0BAF\u0BAA\u0BCD\u0BAA\u0B9F\u0BC1\u0BB5\u0BA4\u0BBF\u0BB2\u0BCD\u0BB2\u0BC8,
    \u0B87\u0BB0\u0BC1\u0BAA\u0BCD\u0BAA\u0BBF\u0BA9\u0BC1\u0BAE\u0BCD \u0BAA\u0BBF\u0B9F\u0BCD
    \u0BAA\u0BCA\u0BA4\u0BC1\u0BB5\u0BBE\u0B95 \u0B9A\u0BC1\u0BB4\u0BB1\u0BCD\u0BB1\u0BAA\u0BCD\u0BAA\u0B9F\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1.
    \u0B85\u0BA4\u0BB1\u0BCD\u0B95\u0BC1 \u0BAA\u0BA4\u0BBF\u0BB2\u0BBE\u0B95, \u0BA4\u0BC1\u0BB3\u0BC8
    \u0BAA\u0BCA\u0BA4\u0BC1\u0BB5\u0BBE\u0B95 \u0BB5\u0BBF\u0BB0\u0BC8\u0BB5\u0BBE\u0B95
    \u0BAE\u0BC0\u0BA3\u0BCD\u0B9F\u0BC1\u0BAE\u0BCD \u0BAE\u0BC0\u0BA3\u0BCD\u0B9F\u0BC1\u0BAE\u0BCD
    \u0B95\u0BC1\u0BB1\u0BC1\u0B95\u0BBF\u0BAF \u0B87\u0BAF\u0B95\u0BCD\u0B95\u0B99\u0BCD\u0B95\u0BB3\u0BC1\u0B9F\u0BA9\u0BCD
    \u0BA4\u0BC1\u0BB3\u0BC8\u0B95\u0BCD\u0B95\u0BC1\u0BB3\u0BCD \u0B92\u0BB0\u0BC1
    \u0BA4\u0BC1\u0BB0\u0BAA\u0BCD\u0BAA\u0BA3 \u0BAA\u0BBF\u0B9F\u0BCD\u0B9F\u0BC8\u0B9A\u0BCD
    \u0B9A\u0BC1\u0BA4\u0BCD\u0BA4\u0BBF\u0BAF\u0BB2\u0BBE\u0BB2\u0BCD \u0B9A\u0BC6\u0BAF\u0BCD\u0BAF\u0BAA\u0BCD\u0BAA\u0B9F\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1.
    \u0B9A\u0BC1\u0BA4\u0BCD\u0BA4\u0BBF\u0BAF\u0BB2\u0BCD \u0B9A\u0BC6\u0BAF\u0BB2\u0BC8
    \u0BA4\u0BC1\u0BB3\u0BC8\u0B95\u0BCD\u0B95\u0BC1 \u0BB5\u0BC6\u0BB3\u0BBF\u0BAF\u0BC7
    (\u0BAE\u0BC7\u0BB2\u0BCD-\u0B9A\u0BC1\u0BA4\u0BCD\u0BA4\u0BBF \u0BA4\u0BC1\u0BB0\u0BAA\u0BCD\u0BAA\u0BA3\u0BAE\u0BCD)
    \u0B85\u0BB2\u0BCD\u0BB2\u0BA4\u0BC1 \u0BA4\u0BC1\u0BB3\u0BC8\u0B95\u0BCD\u0B95\u0BC1\u0BB3\u0BCD
    (\u0B95\u0BC0\u0BB4\u0BCD-\u0BA4\u0BC1\u0BB3\u0BC8 \u0BA4\u0BC1\u0BB0\u0BAA\u0BCD\u0BAA\u0BA3\u0BAE\u0BCD,
    DTH) \u0B9A\u0BC6\u0BAF\u0BCD\u0BAF \u0BAE\u0BC1\u0B9F\u0BBF\u0BAF\u0BC1\u0BAE\u0BCD.
    \u0B95\u0BBF\u0B9F\u0BC8\u0BAE\u0B9F\u0BCD\u0B9F \u0BA4\u0BC1\u0BB3\u0BC8\u0BAF\u0BBF\u0B9F\u0BC1\u0BA4\u0BB2\u0BC1\u0B95\u0BCD\u0B95\u0BC1\u0BAA\u0BCD
    \u0BAA\u0BAF\u0BA9\u0BCD\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BAA\u0BCD\u0BAA\u0B9F\u0BC1\u0BAE\u0BCD
    \u0BAA\u0BAF\u0BBF\u0BB1\u0BCD\u0B9A\u0BBF\u0B95\u0BB3\u0BCD \u0B9F\u0BBF\u0BB0\u0BBF\u0B83\u0BAA\u0BCD\u0B9F\u0BB0\u0BCD
    \u0BAA\u0BAF\u0BBF\u0BB1\u0BCD\u0B9A\u0BBF\u0B95\u0BB3\u0BCD \u0B8E\u0BA9\u0BCD\u0BB1\u0BC1
    \u0B85\u0BB4\u0BC8\u0B95\u0BCD\u0B95\u0BAA\u0BCD\u0BAA\u0B9F\u0BC1\u0B95\u0BBF\u0BA9\u0BCD\u0BB1\u0BA9."
